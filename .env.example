# Public Supabase/Auth settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_AUTH_REDIRECT_URL="http://localhost:3000/orders"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-with-your-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-anon-key"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"

# Server-only keys; never expose these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-supabase-service-role-key"
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM="Mariam Market <onboarding@resend.dev>"

# Optional Paystack integration
PAYSTACK_SECRET_KEY="replace-with-your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="replace-with-your-paystack-public-key"
